@model IEnumerable<MiniMagaza.Models.Product>

@{
    ViewData["Title"] = "Ürün Listesi";
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Başarılı!</strong> @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h2 class="mb-4">Mağazamızdaki Ürünler</h2>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text text-muted">@item.Description</p>
                    
                    <div>
                        <div class="mb-2">
                            @if (item.DiscountPrice.HasValue && item.DiscountPrice < item.Price)
                            {
                                <span class="text-muted text-decoration-line-through" style="font-size: 0.9rem;">
                                    @item.Price.ToString("C2")
                                </span>
                                <br />
                                <span class="text-danger fw-bold fs-4">
                                    @item.DiscountPrice.Value.ToString("C2")
                                </span>
                            }
                            else
                            {
                                <span class="fw-bold fs-4 text-dark">
                                    @item.Price.ToString("C2")
                                </span>
                            }
                        </div>
                        
                    </div>
                    
                    <p class="mt-2">Stok Durumu: <span class="badge bg-info text-dark">@item.Stock Adet</span></p>
                </div>
                <div class="card-footer bg-white border-top-0">
                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary w-100">Detayları Gör</a>
                    <a asp-controller="Cart" asp-action="AddToCart" asp-route-productId="@item.Id" class="btn btn-success w-100 mt-2">
                        <i class="bi bi-cart-plus"></i> Sepete Ekle
                    </a>
                </div>
            </div>
        </div>
    }
</div>